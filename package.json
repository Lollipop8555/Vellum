{
  "name": "vellum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vellum - a local-first browser text editor with swappable engines",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run vendor:check && npm run dict:check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "vendor": "node scripts/vendor-engines.mjs",
    "vendor:pull": "node scripts/vendor-engines.mjs --pull",
    "vendor:check": "node scripts/vendor-engines.mjs --check",
    "verify": "node plans/verify.mjs",
    "dict": "node scripts/vendor-dict.mjs",
    "dict:check": "node scripts/vendor-dict.mjs --check"
  },
  "dependencies": {
    "@viz-js/viz": "^3.31.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.2",
    "katex": "^0.18.10",
    "lowlight": "^3.3.0",
    "marked": "^16.4.2",
    "mermaid": "^12.3.0",
    "prettier": "^3.4.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-cjk-friendly": "^2.3.4",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sql-formatter": "^15.4.9",
    "unified": "^11.0.5",
    "xml-formatter": "^3.6.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
