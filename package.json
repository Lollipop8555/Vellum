{
  "name": "vellum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vellum - a local-first browser text editor with swappable engines",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run vendor:check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "vendor": "node scripts/vendor-engines.mjs",
    "vendor:pull": "node scripts/vendor-engines.mjs --pull",
    "vendor:check": "node scripts/vendor-engines.mjs --check"
  },
  "dependencies": {
    "marked": "^15.0.6",
    "mermaid": "^12.3.0",
    "prettier": "^3.4.2",
    "sql-formatter": "^15.4.9",
    "xml-formatter": "^3.6.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
