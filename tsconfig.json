{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "paths": {
      "@codemirror/*": ["./vendor/@codemirror/*"],
      "@lezer/*": ["./vendor/@lezer/*"],
      "@marijn/*": ["./vendor/@marijn/*"],
      "codemirror": ["./vendor/codemirror"],
      "style-mod": ["./vendor/style-mod"],
      "w3c-keyname": ["./vendor/w3c-keyname"],
      "crelt": ["./vendor/crelt"],
      "monaco-editor": ["./vendor/monaco-editor"],
      "monaco-editor/*": ["./vendor/monaco-editor/*"],
      "unified": ["./vendor/unified"],
      "remark-*": ["./vendor/remark-*"],
      "rehype-*": ["./vendor/rehype-*"],
      "mdast-util-*": ["./vendor/mdast-util-*"],
      "micromark*": ["./vendor/micromark*"],
      "hast-util-*": ["./vendor/hast-util-*"],
      "unist-util-*": ["./vendor/unist-util-*"],
      "vfile*": ["./vendor/vfile*"],
      "katex": ["./vendor/katex"],
      "katex/*": ["./vendor/katex/*"],
      "lowlight": ["./vendor/lowlight"],
      "highlight.js": ["./vendor/highlight.js"],
      "highlight.js/*": ["./vendor/highlight.js/*"],
      "mermaid": ["./vendor/mermaid"],
      "property-information": ["./vendor/property-information"],
      "parse5": ["./vendor/parse5"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
